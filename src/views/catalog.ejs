<%- include('partials/header') %>
<link rel="stylesheet" href="/css/catalog.css">
<link rel="stylesheet" href="/css/main.css">
<main>
    <h1>Course Catalog</h1>
    <p>Browse our available courses and click on any course to see detailed information including available sections and instructors.</p>

    <div class="course-list">
        <% Object.values(courses).forEach(course => { %>
            <div class="course-card">
                <p>
                    <strong>Sections Available:</strong> 
                        <span class="badge">
                        <%= course.section_count || 0 %>
                        </span>
                </p>
                <h3><a href="/courses/<%= course.slug %>" class="btn"><%= course.name %></a></h3>
                <p class="course-id"><%= course.courseCode %> • <%= course.credits %> credits</p>
                <p class="course-description"><%= course.description %></p>
            </div>
        <% }); %>
    </div>
</main>
<%- include('partials/footer') %>